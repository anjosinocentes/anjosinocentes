# =============================================================================
# Projeto Anjos Inocentes - Variáveis de ambiente
# -----------------------------------------------------------------------------
# Copie este arquivo para `.env` (local) e preencha os valores.
# Em produção (Vercel), cadastre estas MESMAS chaves em:
#   Settings > Environment Variables.
# NUNCA versione o arquivo `.env` real (ele está no .gitignore).
# =============================================================================

# Base das chamadas de API do próprio app (mesma origem). Deixe como "/api".
NEXT_PUBLIC_API_URL="/api"

# -----------------------------------------------------------------------------
# Banco de dados (PostgreSQL / Supabase) - OBRIGATÓRIO
# -----------------------------------------------------------------------------
# Local (teste): pode usar a conexão direta (porta 5432).
# PRODUÇÃO/Vercel: use a string do CONNECTION POOLER (porta 6543) - serverless
# abre muitas conexões curtas e a conexão direta esgota o limite do Postgres.
# Supabase: Project Settings > Database > Connection string > "Transaction"/"Pooler".
# Ex.: postgresql://postgres.<ref>:<SENHA>@aws-0-<regiao>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# -----------------------------------------------------------------------------
# Autenticação - OBRIGATÓRIO
# -----------------------------------------------------------------------------
# Segredo forte e aleatório (mín. 16 caracteres) usado para assinar os JWT de sessão.
# Gere um com: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Use o MESMO valor em todos os ambientes de um mesmo deploy (senão as sessões quebram).
JWT_SECRET=

# -----------------------------------------------------------------------------
# E-mail (recuperação de senha) - opcional, mas necessário para "Esqueci minha senha"
# -----------------------------------------------------------------------------
# Gmail SMTP com SENHA DE APP do Google (NUNCA a senha normal da conta).
# Gere em: https://myaccount.google.com/apppasswords
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="Projeto Anjos Inocentes <seuemail@gmail.com>"

# -----------------------------------------------------------------------------
# URL pública do frontend
# -----------------------------------------------------------------------------
# Usada para montar o link de redefinição de senha enviado por e-mail.
# Local: http://localhost:3000
# Produção: a URL real do deploy (ex.: https://projeto-anjos.vercel.app ou domínio próprio).
FRONTEND_URL=http://localhost:3000
