NEXT_PUBLIC_API_URL="/api"
# Connection string do Postgres do seu projeto Supabase (Project Settings > Database > Connection string > URI)
DATABASE_URL=
JWT_SECRET=

# E-mail (recuperação de senha) - Gmail SMTP com Senha de app do Google,
# NUNCA a senha normal da conta. Gere em: https://myaccount.google.com/apppasswords
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="Projeto Anjos Inocentes <seuemail@gmail.com>"

# URL pública do frontend, usada para montar o link de redefinição de senha no e-mail.
# Em produção, aponte para o domínio real (ex: https://meusistema.com).
FRONTEND_URL=http://localhost:3000
